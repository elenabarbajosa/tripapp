EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_APP_ENV=development

# Google Sign-In (native ID token flow — requires a development build)
# Web client ID is required. iOS/Android client IDs are used for platform setup.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Private keys — set as Supabase Edge Function secrets, never EXPO_PUBLIC_
FLIGHT_API_PROVIDER=
FLIGHT_API_KEY=

GEOAPIFY_API_KEY=
