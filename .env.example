EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_APP_ENV=development

# Google Sign-In (native ID token flow — requires a development build)
# Web client ID is required. iOS/Android client IDs are used for platform setup.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Invitation deep links / web accept URLs (optional). Falls back to tripapp://invite/{token}.
EXPO_PUBLIC_INVITATION_BASE_URL=

# Geoapify Map Tiles only (client-visible). Separate from the private autocomplete key.
# Create a map-tiles-restricted key in Geoapify; never reuse GEOAPIFY_API_KEY here.
EXPO_PUBLIC_GEOAPIFY_MAP_KEY=

# Private keys — set as Supabase Edge Function secrets, never EXPO_PUBLIC_ / never app .env
FLIGHT_API_PROVIDER=
FLIGHT_API_KEY=

# Edge Function secrets (set with `npx supabase secrets set ...`, not in app .env):
# GEOAPIFY_API_KEY=   ← private; autocomplete + destination geocoding only
RESEND_API_KEY=
INVITATION_FROM_EMAIL=
